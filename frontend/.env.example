# Copy this file to .env.local (same folder) and fill in the values.
# .env.local is git-ignored, so your passwords never reach GitHub.

# --- MySQL --------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=autocare_app
DB_PASSWORD=AutoCare_DB@2026
DB_NAME=autocare

# --- Sessions -------------------------------------------------------------
# A long random string (32+ characters) used to sign the login cookie.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-string-at-least-32-characters
# Set to true only when the site is served over HTTPS
COOKIE_SECURE=false

# --- Semantic search service (Python / FastAPI / Chroma) -------------------
VECTOR_SERVICE_URL=http://127.0.0.1:8001
# Optional shared secret; must equal VECTOR_SERVICE_TOKEN of the Python service
VECTOR_SERVICE_TOKEN=

# --- Demo password used by `npm run seed` ---------------------------------
DEMO_PASSWORD=Admin123
